# Copy this file to backend/.env. The API loads backend/.env only
# (backend/src/config/env.js). A file at the repository root is ignored.
# Never put real secrets in this example or commit backend/.env.

NODE_ENV=development

# HTTP port. Defaults to 5000 when unset.
PORT=5000

# PostgreSQL connection string. Required.
DATABASE_URL=postgresql://yegna_user:YOUR_PASSWORD@localhost:5432/yegna

# Signs access tokens. Required. In production it must be at least 32 characters.
JWT_SECRET=replace-with-a-long-random-string

# Access-token lifetime. Default is 15m when this is unset.
# These tokens are stateless: they stay valid until they expire, including after
# sign-out or a password change. The web app refreshes them with the refresh session.
# Setting JWT_EXPIRES_IN=330m overrides the 15-minute default and keeps a stolen
# access token usable for five and a half hours. Prefer the short default.
# JWT_EXPIRES_IN=15m

# Comma-separated browser origins allowed to call the API (no trailing slash).
# APP_BASE_URL is added to this list when it is set.
# Outside production, http://localhost, 127.0.0.1 and [::1] are also trusted,
# so the Vite dev server needs nothing here. In production only this list and
# APP_BASE_URL are trusted.
# CORS_ORIGINS=https://app.example.com

# Public origin of the web app, used for payment return URLs and as an extra
# trusted origin. No trailing slash. Leave unset for local development.
# APP_BASE_URL=https://app.example.com

# How many reverse proxies sit in front of the API. Default 0 (the API is
# reached directly). Set 1 behind a single trusted proxy so rate limits and
# session records see the client IP. Do not set this above the number of proxies
# you actually operate.
# TRUST_PROXY=0

# Rate limits. Invalid or non-positive values fall back to these defaults.
# RATE_LIMIT_WINDOW_MS applies to both limiters.
# General API: 600 requests per 15 minutes per client.
# Login and register: 20 requests per 15 minutes per client.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=600
# AUTH_RATE_LIMIT_MAX=20

# Identity check. "mock" (the default) uses the built-in development provider.
# Any other value is rejected: a live Fayda provider is not implemented.
FAYDA_MODE=mock

# Payments. CHAPA_SECRET_KEY is required before a member can start a payment.
# CHAPA_BASE_URL defaults to https://api.chapa.co. Point it at a fake server
# only for contract tests.
# CHAPA_MODE is read and currently unused by the payment client.
CHAPA_MODE=test
CHAPA_SECRET_KEY=
# CHAPA_BASE_URL=https://api.chapa.co

# Read by the loader and not used. There is no Chapa webhook, AI, SMS or email
# delivery. Leave them empty. Do not treat them as working configuration.
CHAPA_WEBHOOK_SECRET=
AI_API_KEY=
SMS_API_KEY=
EMAIL_API_KEY=
