# Base URL of the Yegna API.
# Leave unset in development: Vite proxies /api to VITE_DEV_API_TARGET (default http://localhost:5000).
# In production either serve the web app and API from the same origin (keep /api/v1),
# or set an absolute URL and allow the web origin in the backend CORS configuration.
VITE_API_BASE_URL=/api/v1

# Development only: where the Vite dev server forwards /api requests.
VITE_DEV_API_TARGET=http://localhost:5000
